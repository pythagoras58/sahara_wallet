{
  "name": "sahara-wallet",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "lightningcss": "1.32.0",
    "@tailwindcss/oxide": "4.3.2"
  },
  "scripts": {
    "prepare": "npm run build --workspace=packages/shared",
    "build:shared": "npm run build --workspace=packages/shared",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "typecheck:shared": "npm run typecheck --workspace=packages/shared"
  }
}
