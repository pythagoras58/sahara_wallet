# Copy to .env and fill in for local development.
# For DATABASE_URL, prefer `npx prisma dev -d` (see README) over the placeholder below.
# If using `prisma dev`, append &pgbouncer=true to avoid "prepared statement already exists" errors.

DATABASE_URL="postgresql://sahara:sahara_dev_password@localhost:5432/sahara_wallet?schema=public"
PORT=3000
JWT_SECRET="replace-with-a-random-string-eg-openssl-rand-hex-32"
# Comma-separated list of origins allowed to call this API from a browser (the web app's URL).
CORS_ORIGIN="http://localhost:3001"

# Circle Developer-Controlled Wallets (custody for USDC across Ethereum + Solana).
# Sandbox key from https://console.circle.com -- CircleService.isConfigured() is false, and
# every Circle-backed endpoint returns 503, until both of these are set.
CIRCLE_API_KEY=
# Generated locally + registered with Circle once -- see README "Buy/sell, custody (Circle), send & receive".
CIRCLE_ENTITY_SECRET=

# Not wired up yet -- placeholders for upcoming work:
# SMILE_ID_API_KEY=
# ALCHEMY_API_KEY=
# HELIUS_API_KEY=
